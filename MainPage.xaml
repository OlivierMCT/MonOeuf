<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:OeufFrais.Services"
             x:Class="OeufFrais.MainPage"
             Title="Fraîcheur"
             BackgroundColor="{DynamicResource CouleurFond}">

    <ScrollView>
        <VerticalStackLayout Padding="18,14,18,40" Spacing="16">

            <VerticalStackLayout Spacing="8">
                <Border Style="{StaticResource Pastille}" BackgroundColor="{DynamicResource CouleurAccent}" HorizontalOptions="Start">
                    <Label Text="{svc:Translate Key=Main_Badge}" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="{DynamicResource CouleurTexte}" />
                </Border>
                <Label Text="{svc:Translate Key=Main_Titre}" Style="{StaticResource Titre}" />
            </VerticalStackLayout>

            <!-- ===== Saisie ===== -->
            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="{svc:Translate Key=Main_SectionConnais}" Style="{StaticResource TitreSection}" TextColor="{DynamicResource CouleurAccentFonce}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border x:Name="ChipPonte"
                                Grid.Column="0"
                                Padding="10,12"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChipPonte" />
                            </Border.GestureRecognizers>
                            <Label x:Name="LblChipPonte"
                                   Text="{svc:Translate Key=Main_ChipPonte}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </Border>
                        <Border x:Name="ChipDcr"
                                Grid.Column="1"
                                Padding="10,12"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChipDcr" />
                            </Border.GestureRecognizers>
                            <Label x:Name="LblChipDcr"
                                   Text="{svc:Translate Key=Main_ChipDcr}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </Border>
                    </Grid>

                    <Label x:Name="LblAide"
                           Style="{StaticResource Corps}"
                           FontSize="13"
                           TextColor="{DynamicResource CouleurTexteDouce}" />

                    <Border Style="{StaticResource ChampSaisie}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Text="📅" FontSize="18" VerticalOptions="Center" />
                            <DatePicker x:Name="DpDate"
                                        Grid.Column="1"
                                        Format="dddd d MMMM yyyy"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource CouleurTexte}"
                                        HorizontalOptions="Fill" />
                            <Label Grid.Column="2"
                                   Text="▾"
                                   FontSize="16"
                                   TextColor="{DynamicResource CouleurAccentFonce}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Button x:Name="BtnScan"
                            Text="{svc:Translate Key=Main_BoutonScan}"
                            Clicked="OnScannerBoite"
                            Style="{StaticResource BoutonSecondaire}" />

                    <Label x:Name="LblScan" Style="{StaticResource NoteScan}" />

                    <Button Text="{svc:Translate Key=Common_Calculer}"
                            Clicked="OnCalculer"
                            Style="{StaticResource BoutonPrincipal}" />
                </VerticalStackLayout>
            </Border>

            <!-- ===== Résultats ===== -->
            <VerticalStackLayout x:Name="Resultats"
                                 x:DataType="svc:EggAssessment"
                                 IsVisible="False"
                                 Spacing="16">

                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="12">
                        <Border Style="{StaticResource Pastille}" BackgroundColor="{Binding CouleurStatutClaire}" HorizontalOptions="Start">
                            <Label Text="{Binding Titre}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.4"
                                   TextColor="{Binding CouleurStatut}" />
                        </Border>
                        <Label Text="{Binding Resume}" Style="{StaticResource Corps}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{svc:Translate Key=Main_SectionDates}" Style="{StaticResource TitreSection}" TextColor="{DynamicResource CouleurAccentFonce}" />

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnDefinitions="*,Auto"
                              RowSpacing="9"
                              ColumnSpacing="10">

                            <Label Grid.Row="0" Grid.Column="0" Text="{svc:Translate Key=Main_LabelPonte}" Style="{StaticResource Corps}" TextColor="{DynamicResource CouleurTexteDouce}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding PonteTexte}" Style="{StaticResource Corps}" FontAttributes="Bold" HorizontalTextAlignment="End" />

                            <Label Grid.Row="1" Grid.Column="0" Text="{svc:Translate Key=Main_LabelAge}" Style="{StaticResource Corps}" TextColor="{DynamicResource CouleurTexteDouce}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding AgeTexte}" Style="{StaticResource Corps}" FontAttributes="Bold" HorizontalTextAlignment="End" />

                            <BoxView Grid.Row="2" Grid.ColumnSpan="2" HeightRequest="1" Color="{DynamicResource CouleurBordure}" />

                            <Label Grid.Row="3" Grid.Column="0" Text="{svc:Translate Key=Main_LabelFinExtraFrais}" Style="{StaticResource Corps}" TextColor="{DynamicResource CouleurTexteDouce}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding ExtraFraisTexte}" Style="{StaticResource Corps}" HorizontalTextAlignment="End" />

                            <Label Grid.Row="4" Grid.Column="0" Text="{svc:Translate Key=Main_LabelDcr}" Style="{StaticResource Corps}" TextColor="{DynamicResource CouleurTexteDouce}" />
                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding DcrTexte}" Style="{StaticResource Corps}" FontAttributes="Bold" HorizontalTextAlignment="End" />

                            <Label Grid.Row="5" Grid.Column="0" Text="{svc:Translate Key=Main_LabelPrudence}" Style="{StaticResource Corps}" TextColor="{DynamicResource CouleurTexteDouce}" />
                            <Label Grid.Row="5" Grid.Column="1" Text="{Binding PrudenceTexte}" Style="{StaticResource Corps}" HorizontalTextAlignment="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{svc:Translate Key=Main_SectionUsages}" Style="{StaticResource TitreSection}" TextColor="{DynamicResource CouleurAccentFonce}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Conseils}" Spacing="14">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="svc:UsageConseil">
                                    <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                                        <Border Grid.Column="0"
                                                BackgroundColor="{Binding CouleurClaire}"
                                                StrokeThickness="0"
                                                WidthRequest="26"
                                                HeightRequest="26"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Start"
                                                StrokeShape="RoundRectangle 13">
                                            <Label Text="{Binding Icone}"
                                                   TextColor="{Binding Couleur}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   HorizontalTextAlignment="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="{Binding Usage}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource CouleurTexte}" />
                                            <Label Text="{Binding Detail}"
                                                   FontSize="13.5"
                                                   LineHeight="1.3"
                                                   TextColor="{DynamicResource CouleurTexteDouce}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Carte}" IsVisible="{Binding TestVerreDEauRecommande}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{svc:Translate Key=Common_SectionTestVerre}" Style="{StaticResource TitreSection}" TextColor="{DynamicResource CouleurAccentFonce}" />
                        <VerticalStackLayout x:Name="ListeTestVerre" Spacing="7">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                                        <Label Text="•" TextColor="{DynamicResource CouleurAccentFonce}" FontSize="16" />
                                        <Label Grid.Column="1" Text="{Binding .}" Style="{StaticResource Corps}" FontSize="14" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{svc:Translate Key=Main_Disclaimer}"
                       FontSize="12"
                       LineHeight="1.35"
                       TextColor="{DynamicResource CouleurTexteDouce}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
