<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:OeufFrais.Services"
             x:Class="OeufFrais.ConseilsPage"
             Title="Conserver"
             BackgroundColor="{DynamicResource CouleurFond}">

    <ScrollView>
        <VerticalStackLayout Padding="18,14,18,40" Spacing="16">

            <VerticalStackLayout Spacing="8">
                <Border Style="{StaticResource Pastille}" BackgroundColor="{DynamicResource CouleurAccent}" HorizontalOptions="Start">
                    <Label Text="{svc:Translate Key=Conseils_Badge}" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="{DynamicResource CouleurTexte}" />
                </Border>
                <Label Text="{svc:Translate Key=Conseils_Titre}" Style="{StaticResource Titre}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{svc:Translate Key=Conseils_SectionRegles}" Style="{StaticResource TitreSection}" TextColor="{DynamicResource CouleurAccentFonce}" />
                    <VerticalStackLayout x:Name="ListeRegles" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                                    <Label Text="•" TextColor="{DynamicResource CouleurAccent}" FontSize="16" />
                                    <Label Grid.Column="1" Text="{Binding .}" Style="{StaticResource Corps}" FontSize="14" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{svc:Translate Key=Common_SectionTestVerre}" Style="{StaticResource TitreSection}" TextColor="{DynamicResource CouleurAccentFonce}" />
                    <VerticalStackLayout x:Name="ListeTestVerre" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                                    <Label Text="•" TextColor="{DynamicResource CouleurAccent}" FontSize="16" />
                                    <Label Grid.Column="1" Text="{Binding .}" Style="{StaticResource Corps}" FontSize="14" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{svc:Translate Key=Conseils_SectionDcrDlc}" Style="{StaticResource TitreSection}" TextColor="{DynamicResource CouleurAccentFonce}" />
                    <Label Style="{StaticResource Corps}" FontSize="14"
                           Text="{svc:Translate Key=Conseils_Dcr1}" />
                    <Label Style="{StaticResource Corps}" FontSize="14"
                           Text="{svc:Translate Key=Conseils_Dcr2}" />
                    <Label Style="{StaticResource Corps}" FontSize="14"
                           Text="{svc:Translate Key=Conseils_Dcr3}" />
                </VerticalStackLayout>
            </Border>

            <Label FontSize="12" LineHeight="1.35" TextColor="{DynamicResource CouleurTexteDouce}"
                   Text="{svc:Translate Key=Conseils_Disclaimer}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
