<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:OeufFrais"
             x:Class="OeufFrais.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Palette de l'application -->
            <Color x:Key="Coquille">#FFF3DC</Color>
            <Color x:Key="Jaune">#FFC738</Color>
            <Color x:Key="JauneFonce">#E8960B</Color>
            <Color x:Key="Sarcelle">#21B8A6</Color>
            <Color x:Key="SarcelleFoncee">#0F8C7D</Color>
            <Color x:Key="Corail">#FF6F59</Color>
            <Color x:Key="CorailFonce">#E24B33</Color>
            <Color x:Key="Encre">#2B2622</Color>
            <Color x:Key="EncreDouce">#6B625A</Color>
            <Color x:Key="Blanc">#FFFFFF</Color>
            <Color x:Key="Bordure">#F5DDA8</Color>

            <Style x:Key="Carte" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Blanc}" />
                <Setter Property="Stroke" Value="{StaticResource Bordure}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
                <Setter Property="Shadow">
                    <Shadow Brush="{StaticResource JauneFonce}" Opacity="0.10" Radius="14" Offset="0,6" />
                </Setter>
            </Style>

            <Style x:Key="TitreSection" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource EncreDouce}" />
                <Setter Property="CharacterSpacing" Value="1.5" />
            </Style>

            <Style x:Key="Corps" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{StaticResource Encre}" />
                <Setter Property="LineHeight" Value="1.35" />
            </Style>

            <Style x:Key="Titre" TargetType="Label">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Encre}" />
            </Style>

            <Style x:Key="Pastille" TargetType="Border">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="StrokeShape" Value="RoundRectangle 999" />
            </Style>

            <Style x:Key="BoutonPrincipal" TargetType="Button">
                <Setter Property="TextColor" Value="{StaticResource Encre}" />
                <Setter Property="BackgroundColor" Value="{StaticResource Jaune}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HeightRequest" Value="54" />
                <Setter Property="Shadow">
                    <Shadow Brush="{StaticResource JauneFonce}" Opacity="0.35" Radius="10" Offset="0,5" />
                </Setter>
            </Style>

            <!-- Action secondaire : contour seul, pour ne pas concurrencer le bouton principal. -->
            <Style x:Key="BoutonSecondaire" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource JauneFonce}" />
                <Setter Property="BorderColor" Value="{StaticResource Jaune}" />
                <Setter Property="BorderWidth" Value="1.5" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <Style x:Key="NoteScan" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="1.3" />
                <Setter Property="TextColor" Value="{StaticResource EncreDouce}" />
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
