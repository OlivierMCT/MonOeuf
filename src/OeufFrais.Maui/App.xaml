<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:OeufFrais"
             xmlns:svc="clr-namespace:OeufFrais.Services"
             x:Class="OeufFrais.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Les couleurs de statut arrivent du projet Core en hexadécimal. -->
            <svc:HexVersCouleurConverter x:Key="HexVersCouleur" />

            <!-- Palette de l'application : valeurs réelles injectées au démarrage par ThemeService
                 selon la palette (Miel/Lagon/Corail) et le mode clair/sombre choisis. Les valeurs
                 ci-dessous ne sont que des filets de sécurité si ThemeService n'a pas encore tourné. -->
            <Color x:Key="CouleurFond">#FFF3DC</Color>
            <Color x:Key="CouleurAccent">#FFC738</Color>
            <Color x:Key="CouleurAccentFonce">#E8960B</Color>
            <Color x:Key="CouleurTexte">#2B2622</Color>
            <Color x:Key="CouleurTexteDouce">#6B625A</Color>
            <Color x:Key="CouleurBordure">#F5DDA8</Color>
            <Color x:Key="CouleurCarte">#FFFFFF</Color>

            <Style x:Key="Carte" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource CouleurCarte}" />
                <Setter Property="Stroke" Value="{DynamicResource CouleurBordure}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
                <Setter Property="Shadow">
                    <Shadow Brush="{DynamicResource CouleurAccentFonce}" Opacity="0.10" Radius="14" Offset="0,6" />
                </Setter>
            </Style>

            <Style x:Key="TitreSection" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{DynamicResource CouleurTexteDouce}" />
                <Setter Property="CharacterSpacing" Value="1.5" />
            </Style>

            <Style x:Key="Corps" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{DynamicResource CouleurTexte}" />
                <Setter Property="LineHeight" Value="1.35" />
            </Style>

            <Style x:Key="Titre" TargetType="Label">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{DynamicResource CouleurTexte}" />
            </Style>

            <Style x:Key="Pastille" TargetType="Border">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="StrokeShape" Value="RoundRectangle 999" />
            </Style>

            <Style x:Key="BoutonPrincipal" TargetType="Button">
                <Setter Property="TextColor" Value="{DynamicResource CouleurTexte}" />
                <Setter Property="BackgroundColor" Value="{DynamicResource CouleurAccent}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HeightRequest" Value="54" />
                <Setter Property="Shadow">
                    <Shadow Brush="{DynamicResource CouleurAccentFonce}" Opacity="0.35" Radius="10" Offset="0,5" />
                </Setter>
            </Style>

            <Style x:Key="ChampSaisie" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource CouleurFond}" />
                <Setter Property="Stroke" Value="{DynamicResource CouleurAccent}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="Padding" Value="14,2" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
