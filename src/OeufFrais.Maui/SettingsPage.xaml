<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:OeufFrais.Services"
             x:Class="OeufFrais.SettingsPage"
             Title="Réglages"
             BackgroundColor="{DynamicResource CouleurFond}">

    <ScrollView>
        <VerticalStackLayout Padding="18,14,18,40" Spacing="16">

            <VerticalStackLayout Spacing="8">
                <Border Style="{StaticResource Pastille}" BackgroundColor="{DynamicResource CouleurAccent}" HorizontalOptions="Start">
                    <Label Text="{svc:Translate Key=Settings_Badge}" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="{DynamicResource CouleurTexte}" />
                </Border>
                <Label Text="{svc:Translate Key=Settings_Titre}" Style="{StaticResource Titre}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{svc:Translate Key=Settings_SectionLangue}" Style="{StaticResource TitreSection}" TextColor="{DynamicResource CouleurAccentFonce}" />
                    <VerticalStackLayout x:Name="LangueContainer" Spacing="8" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{svc:Translate Key=Settings_SectionPalette}" Style="{StaticResource TitreSection}" TextColor="{DynamicResource CouleurAccentFonce}" />
                    <Grid x:Name="PaletteContainer" ColumnDefinitions="*,*,*" ColumnSpacing="8" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{svc:Translate Key=Settings_SectionTheme}" Style="{StaticResource TitreSection}" TextColor="{DynamicResource CouleurAccentFonce}" />
                    <Grid x:Name="ThemeContainer" ColumnDefinitions="*,*,*" ColumnSpacing="8" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
