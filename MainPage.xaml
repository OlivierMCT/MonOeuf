<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:OeufFrais.Services"
             x:Class="OeufFrais.MainPage"
             Title="Fraîcheur"
             BackgroundColor="{StaticResource Coquille}">

    <ScrollView>
        <VerticalStackLayout Padding="18,14,18,40" Spacing="16">

            <VerticalStackLayout Spacing="8">
                <Border Style="{StaticResource Pastille}" BackgroundColor="{StaticResource Jaune}" HorizontalOptions="Start">
                    <Label Text="FRAÎCHEUR" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="{StaticResource Encre}" />
                </Border>
                <Label Text="🥚 Cet œuf est-il encore bon ?" Style="{StaticResource Titre}" />
            </VerticalStackLayout>

            <!-- ===== Saisie ===== -->
            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="JE CONNAIS" Style="{StaticResource TitreSection}" TextColor="{StaticResource JauneFonce}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border x:Name="ChipPonte"
                                Grid.Column="0"
                                Padding="10,12"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChipPonte" />
                            </Border.GestureRecognizers>
                            <Label x:Name="LblChipPonte"
                                   Text="Date de ponte"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </Border>
                        <Border x:Name="ChipDcr"
                                Grid.Column="1"
                                Padding="10,12"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChipDcr" />
                            </Border.GestureRecognizers>
                            <Label x:Name="LblChipDcr"
                                   Text="Date sur la boîte (DCR)"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </Border>
                    </Grid>

                    <Label x:Name="LblAide"
                           Style="{StaticResource Corps}"
                           FontSize="13"
                           TextColor="{StaticResource EncreDouce}" />

                    <DatePicker x:Name="DpDate"
                                Format="dddd d MMMM yyyy"
                                FontSize="17"
                                TextColor="{StaticResource Encre}" />

                    <Button x:Name="BtnScan"
                            Text="📷  Lire la date sur la boîte"
                            Clicked="OnScannerBoite"
                            Style="{StaticResource BoutonSecondaire}" />

                    <Label x:Name="LblScan" Style="{StaticResource NoteScan}" />

                    <Button Text="Calculer"
                            Clicked="OnCalculer"
                            Style="{StaticResource BoutonPrincipal}" />
                </VerticalStackLayout>
            </Border>

            <!-- ===== Résultats ===== -->
            <VerticalStackLayout x:Name="Resultats"
                                 x:DataType="svc:EggAssessment"
                                 IsVisible="False"
                                 Spacing="16">

                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="12">
                        <Border Style="{StaticResource Pastille}" BackgroundColor="{Binding CouleurStatutClaire}" HorizontalOptions="Start">
                            <Label Text="{Binding Titre}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.4"
                                   TextColor="{Binding CouleurStatut}" />
                        </Border>
                        <Label Text="{Binding Resume}" Style="{StaticResource Corps}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="LES DATES CLÉS" Style="{StaticResource TitreSection}" TextColor="{StaticResource JauneFonce}" />

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnDefinitions="*,Auto"
                              RowSpacing="9"
                              ColumnSpacing="10">

                            <Label Grid.Row="0" Grid.Column="0" Text="Ponte" Style="{StaticResource Corps}" TextColor="{StaticResource EncreDouce}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding PonteTexte}" Style="{StaticResource Corps}" FontAttributes="Bold" HorizontalTextAlignment="End" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Âge aujourd'hui" Style="{StaticResource Corps}" TextColor="{StaticResource EncreDouce}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding AgeTexte}" Style="{StaticResource Corps}" FontAttributes="Bold" HorizontalTextAlignment="End" />

                            <BoxView Grid.Row="2" Grid.ColumnSpan="2" HeightRequest="1" Color="{StaticResource Bordure}" />

                            <Label Grid.Row="3" Grid.Column="0" Text="Fin de l'extra frais (J+9)" Style="{StaticResource Corps}" TextColor="{StaticResource EncreDouce}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding ExtraFraisTexte}" Style="{StaticResource Corps}" HorizontalTextAlignment="End" />

                            <Label Grid.Row="4" Grid.Column="0" Text="DCR, sur la boîte (J+28)" Style="{StaticResource Corps}" TextColor="{StaticResource EncreDouce}" />
                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding DcrTexte}" Style="{StaticResource Corps}" FontAttributes="Bold" HorizontalTextAlignment="End" />

                            <Label Grid.Row="5" Grid.Column="0" Text="Limite de prudence (DCR+14)" Style="{StaticResource Corps}" TextColor="{StaticResource EncreDouce}" />
                            <Label Grid.Row="5" Grid.Column="1" Text="{Binding PrudenceTexte}" Style="{StaticResource Corps}" HorizontalTextAlignment="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="CE QUE VOUS POUVEZ EN FAIRE" Style="{StaticResource TitreSection}" TextColor="{StaticResource JauneFonce}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Conseils}" Spacing="14">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="svc:UsageConseil">
                                    <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                                        <Border Grid.Column="0"
                                                BackgroundColor="{Binding CouleurClaire}"
                                                StrokeThickness="0"
                                                WidthRequest="26"
                                                HeightRequest="26"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Start"
                                                StrokeShape="RoundRectangle 13">
                                            <Label Text="{Binding Icone}"
                                                   TextColor="{Binding Couleur}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   HorizontalTextAlignment="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="{Binding Usage}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Encre}" />
                                            <Label Text="{Binding Detail}"
                                                   FontSize="13.5"
                                                   LineHeight="1.3"
                                                   TextColor="{StaticResource EncreDouce}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Carte}" IsVisible="{Binding TestVerreDEauRecommande}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="LE TEST DU VERRE D'EAU" Style="{StaticResource TitreSection}" TextColor="{StaticResource JauneFonce}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{x:Static svc:EggCalculator.TestVerreDEau}"
                                             Spacing="7">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                                        <Label Text="•" TextColor="{StaticResource JauneFonce}" FontSize="16" />
                                        <Label Grid.Column="1" Text="{Binding .}" Style="{StaticResource Corps}" FontSize="14" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Repères issus du règlement (CE) n° 589/2008 et des recommandations de l'ANSES. En cas de doute sur l'aspect ou l'odeur d'un œuf, jetez-le."
                       FontSize="12"
                       LineHeight="1.35"
                       TextColor="{StaticResource EncreDouce}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
