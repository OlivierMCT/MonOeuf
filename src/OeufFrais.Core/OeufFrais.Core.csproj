<Project Sdk="Microsoft.NET.Sdk">

	<!-- Règles métier et traductions, sans aucune dépendance d'interface : utilisées par la
	     PWA Blazor WebAssembly et testées seules (tests/OeufFrais.Core.Tests).
	     RootNamespace = OeufFrais pour que les .resx de Resources/Strings gardent leur nom de
	     ressource historique (OeufFrais.Resources.Strings.AppStrings). -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>OeufFrais</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="OeufFrais.Core.Tests" />
	</ItemGroup>

</Project>
