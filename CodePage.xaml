<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:OeufFrais.Services"
             x:Class="OeufFrais.CodePage"
             Title="Code coquille"
             BackgroundColor="{DynamicResource CouleurFond}">

    <ScrollView>
        <VerticalStackLayout Padding="18,14,18,40" Spacing="16">

            <VerticalStackLayout Spacing="8">
                <Border Style="{StaticResource Pastille}" BackgroundColor="{DynamicResource CouleurAccent}" HorizontalOptions="Start">
                    <Label Text="{svc:Translate Key=Code_Badge}" FontSize="12" FontAttributes="Bold" CharacterSpacing="1.2" TextColor="{DynamicResource CouleurTexte}" />
                </Border>
                <Label Text="{svc:Translate Key=Code_Titre}" Style="{StaticResource Titre}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{svc:Translate Key=Code_SectionSaisir}" Style="{StaticResource TitreSection}" TextColor="{DynamicResource CouleurAccentFonce}" />
                    <Entry x:Name="TxtCode"
                           Placeholder="{svc:Translate Key=Code_Placeholder}"
                           FontSize="19"
                           CharacterSpacing="1.5"
                           MaxLength="16"
                           Keyboard="Text"
                           TextColor="{DynamicResource CouleurTexte}"
                           Completed="OnDecoder" />
                    <Button x:Name="BtnScan"
                            Text="{svc:Translate Key=Code_BoutonScan}"
                            Clicked="OnScannerCoquille"
                            Style="{StaticResource BoutonSecondaire}"
                            TextColor="{DynamicResource CouleurAccentFonce}"
                            BorderColor="{DynamicResource CouleurAccent}" />

                    <Label x:Name="LblScan" Style="{StaticResource NoteScan}" />

                    <Button Text="{svc:Translate Key=Code_BoutonDecoder}"
                            Clicked="OnDecoder"
                            BackgroundColor="{DynamicResource CouleurAccent}"
                            TextColor="{DynamicResource CouleurCarte}"
                            FontAttributes="Bold"
                            FontSize="17"
                            CornerRadius="16"
                            HeightRequest="54">
                        <Button.Shadow>
                            <Shadow Brush="{DynamicResource CouleurAccentFonce}" Opacity="0.35" Radius="10" Offset="0,5" />
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Carte}"
                    x:Name="CarteErreur"
                    IsVisible="False">
                <Label x:Name="LblErreur" Style="{StaticResource Corps}" TextColor="#C0392B" />
            </Border>

            <VerticalStackLayout x:Name="Resultat"
                                 x:DataType="svc:ShellCode"
                                 IsVisible="False"
                                 Spacing="16">
                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding CodeNormalise}"
                               FontSize="24"
                               FontAttributes="Bold"
                               CharacterSpacing="2"
                               TextColor="{DynamicResource CouleurAccentFonce}" />

                        <BoxView HeightRequest="1" Color="{DynamicResource CouleurBordure}" />

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="9" ColumnSpacing="10">
                            <Label Grid.Row="0" Grid.Column="0" Text="{svc:Translate Key=Code_LabelMode}" Style="{StaticResource Corps}" TextColor="{DynamicResource CouleurTexteDouce}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding ModeElevage}" Style="{StaticResource Corps}" FontAttributes="Bold" HorizontalTextAlignment="End" />

                            <Label Grid.Row="1" Grid.Column="0" Text="{svc:Translate Key=Code_LabelPays}" Style="{StaticResource Corps}" TextColor="{DynamicResource CouleurTexteDouce}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Pays}" Style="{StaticResource Corps}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                        </Grid>

                        <Label Text="{Binding ModeElevageDetail}"
                               FontSize="13.5"
                               LineHeight="1.3"
                               TextColor="{DynamicResource CouleurTexteDouce}" />

                        <Label Text="{Binding IdentifiantElevageTexte}"
                               FontSize="13"
                               TextColor="{DynamicResource CouleurTexteDouce}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{svc:Translate Key=Code_SectionSavoir}" Style="{StaticResource TitreSection}" TextColor="{DynamicResource CouleurAccentFonce}" />
                    <Label Style="{StaticResource Corps}" FontSize="14"
                           Text="{svc:Translate Key=Code_Savoir1}" />
                    <Label Style="{StaticResource Corps}" FontSize="14"
                           Text="{svc:Translate Key=Code_Savoir2}" />
                    <Label Style="{StaticResource Corps}" FontSize="14"
                           Text="{svc:Translate Key=Code_Savoir3}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
